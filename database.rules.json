{
  "rules": {
    "chat_messages": {
      "$conversationId": {
        ".read": "auth != null",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null && newData.child('senderId').val() == auth.uid",
          ".validate": "newData.hasChildren(['senderId', 'receiverId', 'text', 'createdAt']) && newData.child('senderId').isString() && newData.child('receiverId').isString() && newData.child('text').isString() && newData.child('text').val().length <= 8000"
        }
      }
    }
  }
}
