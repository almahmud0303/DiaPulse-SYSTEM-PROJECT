
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: current user is a doctor (used for read access to patient data).
    // Only call get() when doc exists to avoid rule evaluation failure.
    function isDoctor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'doctor';
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isValidAuditAction(action) {
      return action in [
        'login_success',
        'login_blocked',
        'admin_set_role',
        'admin_set_blocked',
        'admin_delete_user'
      ];
    }

    function isValidAuditCategory(cat) {
      return cat in ['auth', 'admin'];
    }

    // Users: any authenticated user can read (so doctors can list patients; patients can load profiles).
    // Owner can update their doc EXCEPT protected fields (role/blocked).
    // Admin can update any user.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;

      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
          // Prevent self-escalation or unsuspending.
          && request.resource.data.get('role', resource.data.get('role', '')) == resource.data.get('role', '')
          && request.resource.data.get('blocked', resource.data.get('blocked', false)) == resource.data.get('blocked', false)
        );

      allow delete: if isAdmin();
    }

    // Per-user announcement read receipts.
    match /users/{userId}/announcement_reads/{announcementId} {
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Doctor/Admin access requests under the applicant's user doc (reliable client reads).
    match /users/{userId}/access_requests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.userId == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role is string
        && request.resource.data.role == get(/databases/$(database)/documents/users/$(userId)).data.get('role', '')
        && (request.resource.data.role == 'doctor' || request.resource.data.role == 'admin')
        && (!('message' in request.resource.data) || request.resource.data.message == null || request.resource.data.message is string);

      allow update, delete: if isAdmin();
    }

    // Collection-group queries (admin pending queue): explicit read so rules match all paths.
    match /{path=**}/access_requests/{requestId} {
      allow read: if isAdmin();
    }

    // Glucose readings: owner read/write; any authenticated user can read/list (doctors need to view patient readings).
    match /glucose_readings/{readingId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Prescriptions: patient or doctor can read; doctor can create (when saving medicine group).
    match /prescriptions/{rxId} {
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if request.auth != null && isDoctor();
      allow update, delete: if request.auth != null && (isDoctor() || isAdmin());
    }

    // Medicines: owner or doctor can read; owner or doctor can create/update/delete (doctors manage prescriptions).
    match /medicines/{medId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid || isDoctor());
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
    }

    // Medicine entries: owner or doctor can read; only owner can create/update/delete (patients log adherence).
    match /medicine_entries/{entryId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Meals: owner or doctor can read; only owner can write.
    match /meals/{mealId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Activities: owner or doctor can read; only owner can write.
    match /activities/{activityId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Consultation notes: doctor (author or any) and patient can read; doctor can create/update/delete for their notes.
    match /consultation_notes/{noteId} {
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid
          || resource.data.doctorId == request.auth.uid
          || isDoctor()
          || isAdmin());
      allow create: if request.auth != null
        && (request.resource.data.doctorId == request.auth.uid || isDoctor());
      allow update, delete: if request.auth != null
        && (resource.data.doctorId == request.auth.uid || isDoctor() || isAdmin());
    }

    // Conversations: only participants can read/write.
    match /conversations/{convId} {
      allow read, update, delete: if request.auth != null
        && (request.auth.uid in resource.data.get('participants', []) || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.get('participants', []);
    }

    // Messages: sender or receiver can read; only sender can create; sender or receiver can update/delete (e.g. mark read).
    match /messages/{msgId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
    }

    // Appointments: patient creates request; doctor or patient can read; doctor can update (accept/reject).
    match /appointments/{appId} {
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid
          || resource.data.doctorId == request.auth.uid
          || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.patientId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.doctorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // In-app notifications: recipient can read/update; actor can create.
    match /notifications/{nid} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Actor creates a notification (often for another user).
      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.read == false
        && request.resource.data.createdAt is string;
      // Recipient can only mark read/unread, not rewrite content.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.actorId == resource.data.actorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.otherUserId == resource.data.otherUserId
        && request.resource.data.appointmentId == resource.data.appointmentId
        && request.resource.data.appointmentStatus == resource.data.appointmentStatus
        && request.resource.data.read is bool;
      allow delete: if isAdmin();
    }

    // Broadcast campaigns/announcements. Admin writes; signed-in users read published.
    match /announcements/{aid} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.get('published', false) == true);
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.published is bool;
      allow update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }

    // Audit log: append-only; actor must match caller. Retention: Cloud Function purges docs older than 90 days.
    match /audit_logs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorId is string
        && request.resource.data.keys().hasAll(['actorId', 'action', 'category', 'createdAt', 'metadata'])
        && request.resource.data.action is string
        && request.resource.data.category is string
        && isValidAuditAction(request.resource.data.action)
        && isValidAuditCategory(request.resource.data.category)
        && request.resource.data.metadata is map
        && request.resource.data.metadata.size() <= 32
        && (!('targetUserId' in request.resource.data)
          || (request.resource.data.targetUserId is string
            && request.resource.data.targetUserId.size() <= 128));
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
