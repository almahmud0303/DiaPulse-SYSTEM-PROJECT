rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: current user is a doctor (used for read access to patient data).
    function isDoctor() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'doctor';
    }

    // Users: own doc read/write; doctors can read any user (to list patients and view profiles).
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isDoctor());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite codes: admins create/delete. Read allowed without auth so users can
    // validate codes during registration (before they're logged in).
    match /inviteCodes/{codeId} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Glucose readings: owner read/write; any authenticated user can read/list (doctors need to view patient readings).
    match /glucose_readings/{readingId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Medicines: owner or doctor can read; owner or doctor can create/update/delete (doctors manage prescriptions).
    match /medicines/{medId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor());
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid || isDoctor());
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor());
    }

    // Medicine entries: owner or doctor can read; only owner can create/update/delete (patients log adherence).
    match /medicine_entries/{entryId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Meals: owner or doctor can read; only owner can write.
    match /meals/{mealId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Activities: owner or doctor can read; only owner can write.
    match /activities/{activityId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isDoctor());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Consultation notes: doctor (author or any) and patient can read; doctor can create/update/delete for their notes.
    match /consultation_notes/{noteId} {
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid || isDoctor());
      allow create: if request.auth != null
        && (request.resource.data.doctorId == request.auth.uid || isDoctor());
      allow update, delete: if request.auth != null
        && (resource.data.doctorId == request.auth.uid || isDoctor());
    }

    // Conversations: only participants can read/write.
    match /conversations/{convId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.get('participants', []);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.get('participants', []);
    }

    // Messages: sender or receiver can read; only sender can create; sender or receiver can update/delete (e.g. mark read).
    match /messages/{msgId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }
  }
}
